# Alternative à pm2 : service systemd.
# Copier dans /etc/systemd/system/strikepoint.service, adapter User et WorkingDirectory, puis :
#   sudo systemctl daemon-reload && sudo systemctl enable --now strikepoint
[Unit]
Description=STRIKEPOINT (jeu, comptes, multijoueur)
After=network.target

[Service]
Type=simple
User=strikepoint
WorkingDirectory=/opt/strikepoint
Environment=NODE_ENV=production
Environment=GAME_PORT=8081
Environment=TRUST_PROXY=1
ExecStart=/usr/bin/node server/server.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
